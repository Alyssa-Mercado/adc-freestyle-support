# ─── watsonx Orchestrate environment ─────────────────────────────────────────
# Copy this file to .env and fill in your values before running any commands.
# NEVER commit .env to source control.

# Your watsonx Orchestrate instance URL
WATSONX_ORCHESTRATE_URL=https://<your-instance>.orchestrate.ibm.com

# IBM Cloud API key (used to obtain IAM bearer tokens)
IBM_CLOUD_API_KEY=<your-ibm-cloud-api-key>

# The ADK environment name you activate with: orchestrate env activate <name>
WXO_ENV_NAME=production

# ─── Abbott Support Case REST API ────────────────────────────────────────────
# Base URL for the FreeStyle Libre support backend API
ADC_SUPPORT_API_BASE_URL=https://api.freestyle-support.abbott.com

# ─── Logging / Observability ─────────────────────────────────────────────────
LOG_LEVEL=INFO
